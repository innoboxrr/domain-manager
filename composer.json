{
    "name": "innoboxrr/domain-manager",
    "version": "1.0.36",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Innoboxrr\\DomainManager\\": "src/",
            "Innoboxrr\\DomainManager\\Database\\Factories\\": "database/factories/"
        }
    },
    "authors": [
        {
            "name": "Homero Raul",
            "email": "h.raulvc@gmail.com"
        }
    ],
    "minimum-stability": "stable",
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "innoboxrr/larapack-generator": "^7.0",
        "phpunit/phpunit": "^11.5 || ^12.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Innoboxrr\\DomainManager\\Providers\\AppServiceProvider",
                "Innoboxrr\\DomainManager\\Providers\\AuthServiceProvider",
                "Innoboxrr\\DomainManager\\Providers\\EventServiceProvider",
                "Innoboxrr\\DomainManager\\Providers\\RouteServiceProvider"
            ]
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Innoboxrr\\DomainManager\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.3",
        "illuminate/support": "^13.0"
    },
    "suggest": {
        "maatwebsite/excel": "Necesario para las exportaciones del paquete (^3.1)."
    },
    "description": "Gestion de dominios en Laravel: proveedores (AWS, Namecheap), TLD, DNS, contactos, suscripciones, renovaciones y pagos."
}
